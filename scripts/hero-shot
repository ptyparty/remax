#!/bin/bash

# Regenerate hero.png without a human at a terminal: build and seed the
# standard hero state (scripts/hero --no-launch), then render the final
# remax frame to a 2x PNG via a pty capture, pyte, and headless Chrome.
#
# Needs python3 (pyte and pillow are installed into a scratch venv on
# first run) and Google Chrome or Chromium on PATH.

set -e

cd "$(dirname "$0")/.."

HERO_DIR="${HERO_DIR:-/tmp/remax-hero}"
REMAX_BIN="${REMAX_BIN:-remax}"
OUT="${1:-hero.png}"

scripts/hero --no-launch

VENV="$HERO_DIR/venv"
if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" -q install pyte pillow
fi

"$VENV/bin/python" scripts/lib/hero_shot.py "$HERO_DIR" "$REMAX_BIN" "$OUT"
