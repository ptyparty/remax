#!/bin/bash

set -euo pipefail

cd "$(dirname "$0")/.."

CAST_DIR="${CAST_DIR:-/tmp/remax-hero-cast}"
OUT="${1:-hero}"

mkdir -p "$CAST_DIR"
VENV="$CAST_DIR/venv"
if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" -q install pyte pillow
fi

PYTHONDONTWRITEBYTECODE=1 "$VENV/bin/python" scripts/lib/hero_cast.py "$OUT"
