#!/bin/bash

# Regenerate hero.gif without a human at a terminal: build and seed the
# standard hero state (scripts/hero --no-launch), then drive a short
# review through a pty and record the emulated screen as an animation.
#
# Needs python3 (pyte and pillow are installed into a scratch venv on
# first run) and a monospace TTF. No browser, unlike the still it
# replaced — the frames are drawn cell by cell.

set -e

cd "$(dirname "$0")/.."

HERO_DIR="${HERO_DIR:-/tmp/remax-hero}"
REMAX_BIN="${REMAX_BIN:-remax}"
OUT="${1:-hero.gif}"

scripts/hero --no-launch

VENV="$HERO_DIR/venv"
if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" -q install pyte pillow
fi

"$VENV/bin/python" scripts/lib/hero_cast.py "$HERO_DIR" "$REMAX_BIN" "$OUT"
